        {
          "name": "7. Checkout 2 kantin, 1 QRIS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{checkoutBody}}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const addons = [pm.collectionVariables.get(\"addonA1\"), pm.collectionVariables.get(\"addonA2\")].filter(x => x !== \"\" && x !== undefined).map(Number);",
                  "const carts = [{vendor_id: Number(pm.collectionVariables.get(\"vendorA\")), order_type: \"dine_in\",",
                  "  items: [{menu_id: Number(pm.collectionVariables.get(\"menuA\")), qty: 2, addon_ids: addons, note: \"tidak pedas\"}]}];",
                  "if (pm.collectionVariables.get(\"menuB\")) carts.push({vendor_id: Number(pm.collectionVariables.get(\"vendorB\")), items: [{menu_id: Number(pm.collectionVariables.get(\"menuB\")), qty: 1}]});",
                  "pm.collectionVariables.set(\"checkoutBody\", JSON.stringify({carts}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const p = pm.response.json().payment;",
                  "pm.test(\"satu pembayaran berisi pesanan per kantin\", () => pm.expect(p.orders.length).to.be.above(0));",
                  "pm.test(\"ada kode ambil\", () => pm.expect(p.orders[0].pickup_code).to.have.lengthOf(4));",
                  "pm.collectionVariables.set(\"paymentId\", p.id);",
                  "const o = p.orders.find(o => o.vendor_id == pm.collectionVariables.get(\"vendorA\"));",
                  "pm.collectionVariables.set(\"orderId\", o.id);"
                ]
              }
            }
          ]
        },
