  },
  "item": [
    {
      "name": "A. Mahasiswa",
      "item": [
        {
          "name": "1. Health (cek server & mode bayar)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mode bayar: \" + pm.response.json().payment_mode, () => pm.expect([\"mock\", \"xendit\"]).to.include(pm.response.json().payment_mode));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Semua menu (beranda) + pilih menu untuk tes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menus"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const ms = pm.response.json();",
                  "pm.test(\"ada menu\", () => pm.expect(ms.length).to.be.above(0));",
                  "pm.test(\"menu punya gambar\", () => pm.expect(ms[0].image_url).to.be.a(\"string\").and.not.empty);",
                  "// Menu A: dari kantin akun vendor yang dites (default Warung Bu Sari), yang punya topping",
                  "const store = pm.collectionVariables.get(\"vendorStoreName\");",
                  "const a = ms.find(m => m.store_name === store && m.addons.length >= 2) || ms.find(m => m.addons.length >= 2) || ms[0];",
                  "const b = ms.find(m => m.vendor_id !== a.vendor_id);",
                  "pm.collectionVariables.set(\"menuA\", a.id);",
                  "pm.collectionVariables.set(\"vendorA\", a.vendor_id);",
                  "pm.collectionVariables.set(\"addonA1\", a.addons[0] ? a.addons[0].id : \"\");",
                  "pm.collectionVariables.set(\"addonA2\", a.addons[1] ? a.addons[1].id : \"\");",
                  "pm.collectionVariables.set(\"menuB\", b ? b.id : \"\");",
                  "pm.collectionVariables.set(\"vendorB\", b ? b.vendor_id : \"\");",
                  "console.log(\"Menu A:\", a.name, \"(\" + a.store_name + \")\", \"Menu B:\", b && b.name, \"(\" + (b && b.store_name) + \")\");"
                ]
              }
            }
          ]
        },
