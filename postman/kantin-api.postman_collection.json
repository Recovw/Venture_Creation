            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Mahasiswa Demo\",\"email\":\"{{studentEmail}}\",\"password\":\"{{studentPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 = akun baru dibuat, 409 = email sudah terdaftar (tetap lanjut ke login)",
                  "pm.test(\"terdaftar atau sudah ada\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"studentToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
